{
  "openapi": "3.0.3",
  "info": {
    "title": "Heimdall Authority & Wallet API",
    "version": "1.0.0",
    "description": "OpenAPI specification for Heimdall SSI Authority, GNAP GateKeeper, OID4VCI Issuer, OID4VP Verifier, Approver Console, and Embedded Wallet.",
    "contact": {
      "name": "EUNOMIA Support",
      "email": "support@eunomia.upm.es"
    }
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Default API v1 Base Path"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "GnapAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "GNAP Access Token. Must be prefixed with 'GNAP '."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Invalid Format" },
          "error_code": { "type": "integer", "example": 3120 },
          "details": { "type": "string", "nullable": true }
        },
        "required": ["message", "error_code"]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "username": { "type": "string", "nullable": true },
          "email": { "type": "string", "nullable": true },
          "role": { "type": "string" },
          "root": { "type": "boolean" }
        },
        "required": ["userId", "role", "root"]
      },
      "ParticipantType": {
        "type": "string",
        "enum": ["Agent", "Authority", "All"]
      },
      "Visibility": {
        "type": "string",
        "enum": ["Private", "Anonymous", "Public"]
      },
      "GrantStatus": {
        "type": "string",
        "enum": ["Processing", "Pending", "Approved", "Rejected", "Finalized"]
      },
      "ParticipantDto": {
        "type": "object",
        "properties": {
          "participant_id": { "type": "string", "example": "did:web:authority.example.com" },
          "participant_nick": { "type": "string", "example": "Authority Node" },
          "participant_type": { "$ref": "#/components/schemas/ParticipantType" },
          "base_url": { "type": "string", "example": "https://authority.example.com" },
          "saved_at": { "type": "string", "format": "date-time" },
          "last_interaction": { "type": "string", "format": "date-time" },
          "extra_fields": { "type": "object", "additionalProperties": true }
        },
        "required": [
          "participant_id",
          "participant_nick",
          "participant_type",
          "base_url",
          "saved_at",
          "last_interaction",
          "extra_fields"
        ]
      },
      "RecvGrantDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string" },
          "visibility": { "$ref": "#/components/schemas/Visibility" },
          "participant_nick": { "type": "string" },
          "participant_id": { "type": "string", "nullable": true },
          "kind": { "type": "string" },
          "final_token_hash": { "type": "string", "nullable": true },
          "final_expires_at": { "type": "string", "format": "date-time", "nullable": true },
          "managing_id": { "type": "string", "nullable": true },
          "managing_token_hash": { "type": "string", "nullable": true },
          "managing_expires_at": { "type": "string", "format": "date-time", "nullable": true },
          "vc_type_config": {
            "type": "array",
            "items": { "type": "string" },
            "nullable": true
          },
          "status": { "$ref": "#/components/schemas/GrantStatus" },
          "created_at": { "type": "string", "format": "date-time" },
          "ended_at": { "type": "string", "format": "date-time", "nullable": true }
        },
        "required": [
          "id",
          "role",
          "visibility",
          "participant_nick",
          "kind",
          "status",
          "created_at"
        ]
      },
      "BuildCtxDto": {
        "type": "object",
        "properties": {
          "subject_name": { "type": "string" },
          "holder_did": { "type": "string", "nullable": true },
          "cert": { "type": "string", "nullable": true },
          "vcs": { "type": "array", "items": { "type": "string" } },
          "claims": { "type": "object", "additionalProperties": true, "nullable": true }
        },
        "required": ["subject_name", "vcs"]
      },
      "IssuanceDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string" },
          "subject_name": { "type": "string" },
          "pre_auth_code": { "type": "string" },
          "vc_type_config": { "type": "array", "items": { "type": "string" } },
          "token": { "type": "string" },
          "token_expiration": { "type": "integer", "format": "int64" },
          "nonce": { "type": "string" },
          "aud": { "type": "string" },
          "issuer_did": { "type": "string" },
          "credential_id": { "type": "string" },
          "credential": { "type": "string", "nullable": true },
          "build_ctx": { "$ref": "#/components/schemas/BuildCtxDto" }
        },
        "required": [
          "id",
          "role",
          "subject_name",
          "pre_auth_code",
          "vc_type_config",
          "token",
          "token_expiration",
          "nonce",
          "aud",
          "issuer_did",
          "credential_id",
          "build_ctx"
        ]
      },
      "RecvInteractionDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "start": { "type": "array", "items": {} },
          "method": { "type": "string" },
          "callback_uri": { "type": "string" },
          "key_source": { "type": "object", "additionalProperties": true },
          "client_nonce": { "type": "string" },
          "hash_method": { "type": "string" },
          "hints": { "type": "string", "nullable": true },
          "continuation_endpoint": { "type": "string" },
          "continuation_id": { "type": "string" },
          "continuation_token": { "type": "string" },
          "continuation_wait": { "type": "integer", "format": "int64", "nullable": true },
          "as_nonce": { "type": "string" },
          "interact_ref": { "type": "string" },
          "hash": { "type": "string" }
        },
        "required": [
          "id",
          "start",
          "method",
          "callback_uri",
          "client_nonce",
          "hash_method",
          "continuation_endpoint",
          "continuation_id",
          "continuation_token",
          "as_nonce",
          "interact_ref",
          "hash"
        ]
      },
      "RecvVerificationDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "state": { "type": "string" },
          "nonce": { "type": "string" },
          "vc_type": { "type": "array", "items": {} },
          "audience": { "type": "string" },
          "holder": { "type": "string", "nullable": true },
          "vpt": { "type": "string", "nullable": true },
          "vcs": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "ended_at": { "type": "string", "format": "date-time", "nullable": true }
        },
        "required": ["id", "state", "nonce", "vc_type", "audience", "vcs", "status", "created_at"]
      },
      "RequestDetailsDto": {
        "type": "object",
        "properties": {
          "grant": { "$ref": "#/components/schemas/RecvGrantDto" },
          "issuance": {
            "allOf": [{ "$ref": "#/components/schemas/IssuanceDto" }],
            "nullable": true
          },
          "interaction": {
            "allOf": [{ "$ref": "#/components/schemas/RecvInteractionDto" }],
            "nullable": true
          },
          "verification": {
            "allOf": [{ "$ref": "#/components/schemas/RecvVerificationDto" }],
            "nullable": true
          }
        },
        "required": ["grant"]
      },
      "VcDecisionApproval": {
        "type": "object",
        "properties": {
          "approve": { "type": "boolean", "example": true }
        },
        "required": ["approve"]
      },
      "WalletKeyRefDto": {
        "type": "object",
        "properties": {
          "internal": { "type": "string" },
          "fragment": { "type": "string" }
        },
        "required": ["internal", "fragment"]
      },
      "WalletDidDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "did": { "type": "string" },
          "alias": { "type": "string", "nullable": true },
          "default": { "type": "boolean" },
          "type": { "type": "string" },
          "keys": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/WalletKeyRefDto" }
          },
          "default_key": { "$ref": "#/components/schemas/WalletKeyRefDto" },
          "did_document": { "type": "object", "additionalProperties": true },
          "added_on": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "did", "default", "type", "keys", "default_key", "did_document", "added_on"]
      },
      "WalletInfoDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "dids": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/WalletDidDto" }
          },
          "default_did": {
            "allOf": [{ "$ref": "#/components/schemas/WalletDidDto" }],
            "nullable": true
          },
          "keys_count": { "type": "integer" },
          "credentials_count": { "type": "integer" }
        },
        "required": ["id", "name", "dids", "keys_count", "credentials_count"]
      },
      "WalletKeyDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "alias": { "type": "string", "nullable": true },
          "kty": { "type": "string" },
          "crv": { "type": "string", "nullable": true },
          "added_on": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "kty", "added_on"]
      },
      "RegisterKeyRequest": {
        "type": "object",
        "properties": {
          "pem": { "type": "string" },
          "alias": { "type": "string", "nullable": true }
        },
        "required": ["pem"]
      },
      "RegisterDidRequest": {
        "type": "object",
        "properties": {
          "builder": { "type": "object", "additionalProperties": true },
          "keys_id": { "type": "array", "items": { "type": "string" } },
          "alias": { "type": "string", "nullable": true },
          "service": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true },
            "nullable": true
          }
        },
        "required": ["builder", "keys_id"]
      },
      "WalletCredentialDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "added_on": { "type": "string", "format": "date-time", "nullable": true },
          "valid_until": { "type": "string", "format": "date-time", "nullable": true },
          "parsed_document": { "type": "object", "additionalProperties": true }
        },
        "required": ["id"]
      },
      "OidcUriRequest": {
        "type": "object",
        "properties": {
          "uri": { "type": "string" }
        },
        "required": ["uri"]
      },
      "GrantRequest": {
        "type": "object",
        "additionalProperties": true
      },
      "GrantResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "RefBody": {
        "type": "object",
        "properties": {
          "interact_ref": { "type": "string" }
        },
        "required": ["interact_ref"]
      },
      "TokenRequest": {
        "type": "object",
        "properties": {
          "grant_type": { "type": "string" },
          "pre-authorized_code": { "type": "string" },
          "tx_code": { "type": "string" }
        },
        "required": ["grant_type", "pre-authorized_code"]
      },
      "CredentialRequest": {
        "type": "object",
        "additionalProperties": true
      },
      "VerifyPayload": {
        "type": "object",
        "properties": {
          "vp_token": { "type": "string" },
          "presentation_submission": { "type": "string" }
        },
        "required": ["vp_token", "presentation_submission"]
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check Server Health",
        "tags": ["Health"],
        "responses": {
          "200": { "description": "Healthy" }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Get Current Console User Session",
        "tags": ["Session"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Authenticated user info",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MeDto" }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/minions/all": {
      "get": {
        "operationId": "getAllParticipants",
        "summary": "List All Known Network Participants",
        "tags": ["Participants"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Participants array",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ParticipantDto" }
                }
              }
            }
          }
        }
      }
    },
    "/minions/myself": {
      "get": {
        "operationId": "getMyself",
        "summary": "Get Local Authority Participant Identity",
        "tags": ["Participants"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Local participant record",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ParticipantDto" }
              }
            }
          }
        }
      }
    },
    "/minions/{id}": {
      "get": {
        "operationId": "getParticipantById",
        "summary": "Get Participant by DID Identifier",
        "tags": ["Participants"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The participant's DID as base64url without padding (RFC 4648 §5), so `:` and `%3A` survive every URL decoding.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Participant details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ParticipantDto" }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/approver/all": {
      "get": {
        "operationId": "getAllRequests",
        "summary": "Get All Credential Requests",
        "tags": ["Approver"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of credential grant requests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/RecvGrantDto" }
                }
              }
            }
          }
        }
      }
    },
    "/approver/{id}": {
      "get": {
        "operationId": "getRequestById",
        "summary": "Get Credential Request Grant by ID",
        "tags": ["Approver"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Grant record",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecvGrantDto" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "manageRequest",
        "summary": "Approve or Reject Credential Request",
        "tags": ["Approver"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VcDecisionApproval" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision processed",
            "content": {
              "text/plain": { "schema": { "type": "string" } }
            }
          },
          "422": { "description": "Interaction rejected or failed" }
        }
      }
    },
    "/approver/{id}/details": {
      "get": {
        "operationId": "getRequestDetails",
        "summary": "Get Full Credential Request Details (Grant, Issuance, Interaction, Verification)",
        "tags": ["Approver"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Full request details bundle",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RequestDetailsDto" }
              }
            }
          }
        }
      }
    },
    "/wallet/is-linked": {
      "get": {
        "operationId": "isWalletLinked",
        "summary": "Check if Wallet is Linked",
        "tags": ["Wallet"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Wallet is linked" },
          "404": { "description": "Wallet is not linked" }
        }
      }
    },
    "/wallet/link": {
      "post": {
        "operationId": "linkWallet",
        "summary": "Link and Initialize Wallet",
        "tags": ["Wallet"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Wallet linked" }
        }
      }
    },
    "/wallet/info": {
      "get": {
        "operationId": "getWalletInfo",
        "summary": "Get Wallet Overview Information",
        "tags": ["Wallet"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Wallet overview",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WalletInfoDto" }
              }
            }
          }
        }
      }
    },
    "/wallet/keys": {
      "get": {
        "operationId": "getWalletKeys",
        "summary": "List Registered Wallet Keys",
        "tags": ["Wallet"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of keys",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/WalletKeyDto" }
                }
              }
            }
          }
        }
      }
    },
    "/wallet/key": {
      "post": {
        "operationId": "registerWalletKey",
        "summary": "Import Private Key PEM into Wallet",
        "tags": ["Wallet"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterKeyRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Key registered" }
        }
      }
    },
    "/wallet/key/{id}": {
      "delete": {
        "operationId": "deleteWalletKey",
        "summary": "Delete Wallet Key by ID",
        "tags": ["Wallet"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Key deleted" }
        }
      }
    },
    "/wallet/did": {
      "get": {
        "operationId": "getWalletDefaultDid",
        "summary": "Get Default Wallet DID String",
        "tags": ["Wallet"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Default DID",
            "content": { "text/plain": { "schema": { "type": "string" } } }
          }
        }
      },
      "post": {
        "operationId": "registerWalletDid",
        "summary": "Create and Register a DID",
        "tags": ["Wallet"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterDidRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "DID registered" }
        }
      }
    },
    "/wallet/did/{id}": {
      "delete": {
        "operationId": "deleteWalletDid",
        "summary": "Delete DID by ID",
        "tags": ["Wallet"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "DID deleted" }
        }
      }
    },
    "/wallet/did/{id}/default": {
      "post": {
        "operationId": "setDefaultWalletDid",
        "summary": "Set Default Wallet DID",
        "tags": ["Wallet"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Updated DID record",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/WalletDidDto" } }
            }
          }
        }
      }
    },
    "/wallet/did/{id}/key/{key_id}": {
      "post": {
        "operationId": "addKeyToDid",
        "summary": "Bind Key to DID",
        "tags": ["Wallet"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "key_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Updated DID record",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/WalletDidDto" } }
            }
          }
        }
      },
      "delete": {
        "operationId": "removeKeyFromDid",
        "summary": "Remove Key from DID",
        "tags": ["Wallet"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "key_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Updated DID record",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/WalletDidDto" } }
            }
          }
        }
      }
    },
    "/wallet/did/{id}/key/default/{key_id}": {
      "post": {
