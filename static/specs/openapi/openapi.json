    "/api/v1/gate/access": {
      "post": {
        "tags": [
          "Gatekeeper"
        ],
        "summary": "Request a grant",
        "responses": {
          "200": {
            "description": "The decision, or a GNAP error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GrantResponse"
                }
              }
            }
          }
        },
        "description": "Starts a credential request. The body must be signed with HTTP Message Signatures.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GrantRequest"
              }
            }
          }
        }
      }
    },
