  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Invalid Format"
          },
          "error_code": {
            "type": "integer",
            "example": 3120
          },
          "details": {
            "type": "string",
            "nullable": true,
            "example": "Missing required field 'proof'"
          }
        },
        "required": [
          "message",
          "error_code"
        ]
      },
      "RefBody": {
        "type": "object",
        "properties": {
          "interact_ref": {
            "type": "string",
            "example": "ref-1234-5678"
          }
        },
        "required": [
          "interact_ref"
        ]
      },
      "TokenRequest": {
        "type": "object",
        "properties": {
          "grant_type": {
            "type": "string",
            "example": "urn:ietf:params:oauth:grant-type:pre-authorized_code"
          },
          "pre-authorized_code": {
            "type": "string",
            "example": "1234-code-5678"
          },
          "tx_code": {
            "type": "string",
            "example": "123456"
          }
        },
        "required": [
          "grant_type",
          "pre-authorized_code"
        ]
      },
      "VerifyPayload": {
        "type": "object",
        "properties": {
          "vp_token": {
            "type": "string",
            "description": "Verifiable Presentation Token",
            "example": "eyJhbGciOi..."
          },
          "presentation_submission": {
            "type": "string",
            "description": "JSON string of presentation submission",
            "example": "{\"id\":\"...\",\"definition_id\":\"...\",\"descriptor_map\":[...]}"
          }
        },
        "required": [
          "vp_token",
          "presentation_submission"
        ]
      },
      "GrantRequest": {
        "type": "object",
        "description": "A GNAP grant request (RFC 9635). It must be signed with HTTP Message Signatures using the key in `client.key`, a JWK or a PEM certificate. Asking for `oid4vp` in `interact.start` requires a presentation; otherwise the certificate path applies.",
        "required": [
          "client"
        ]
      },
      "GrantResponse": {
        "type": "object",
        "description": "A GNAP response. Depending on the decision it carries a credential offer URI, a presentation request URI or a continuation. On failure it carries `error`."
      },
      "CredentialRequest": {
        "type": "object",
        "description": "An OID4VCI credential request with a proof of possession of the holder key."
      },
      "RegisterKey": {
        "type": "object",
        "required": [
          "pem"
        ],
        "properties": {
          "pem": {
            "type": "string",
            "description": "Private key in PEM format."
          },
          "alias": {
            "type": "string"
          }
        }
      },
      "RegisterDid": {
        "type": "object",
        "required": [
          "builder",
          "keys_id"
        ],
        "properties": {
          "builder": {
            "type": "object",
            "description": "DID method and its parameters."
          },
          "keys_id": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "alias": {
            "type": "string"
          },
          "service": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "DID document service entries."
          }
        }
      }
    }
  }
}